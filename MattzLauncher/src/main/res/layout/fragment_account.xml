<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/fragment_menu_main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/nexus_bg"
    tools:ignore="ContentDescription,HardcodedText,SmallSp">

    <!-- TOP HEADER: NEXUS EDITORIAL (40DP HEIGHT) -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/operation_layout"
        android:layout_width="match_parent"
        android:layout_height="40dp"
        android:layout_marginTop="6dp"
        android:paddingHorizontal="16dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Back Button: 32dp x 32dp circular glass -->
        <ImageView
            android:id="@+id/return_button"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_nexus_circle_btn"
            android:clickable="true"
            android:focusable="true"
            android:padding="7dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_nexus_arrow_left"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Title -->
        <TextView
            android:id="@+id/account_header_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="@string/account_title"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toEndOf="@id/return_button"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Right Action Buttons -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <!-- Secondary Dark Glass Capsule: Add Microsoft -->
            <com.mattz.launcher.ui.layout.AnimRelativeLayout
                android:id="@+id/add_microsoft_account"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_nexus_pill_glass"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingHorizontal="12dp">

                <ImageView
                    android:id="@+id/add_microsoft_image"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ic_nexus_plus" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="5dp"
                    android:layout_toEndOf="@id/add_microsoft_image"
                    android:text="@string/account_microsoft_account"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp" />

            </com.mattz.launcher.ui.layout.AnimRelativeLayout>

            <!-- Primary White Capsule: Add Local -->
            <com.mattz.launcher.ui.layout.AnimRelativeLayout
                android:id="@+id/add_local_account"
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:layout_marginEnd="6dp"
                android:background="@drawable/bg_nexus_pill_white"
                android:clickable="true"
                android:focusable="true"
                android:gravity="center"
                android:paddingHorizontal="14dp">

                <ImageView
                    android:id="@+id/add_local_image"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ic_nexus_plus"
                    app:tint="@color/nexus_pill_active_text" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="5dp"
                    android:layout_toEndOf="@id/add_local_image"
                    android:text="@string/account_local_account"
                    android:textColor="@color/nexus_pill_active_text"
                    android:textSize="10sp"
                    android:textStyle="bold" />

            </com.mattz.launcher.ui.layout.AnimRelativeLayout>

            <!-- More Options: 32dp x 32dp circular glass -->
            <ImageView
                android:id="@+id/add_server"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:background="@drawable/bg_nexus_circle_btn"
                android:clickable="true"
                android:focusable="true"
                android:padding="7dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_more" />

        </LinearLayout>

        <!-- Hidden include for view_account anchor -->
        <FrameLayout
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone">

            <include
                android:id="@+id/view_account"
                layout="@layout/view_account"
                android:layout_width="0dp"
                android:layout_height="0dp" />

        </FrameLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- MAIN BENTO DARK GLASS CONTAINER -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/account_menu"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginHorizontal="16dp"
        android:layout_marginVertical="8dp"
        android:background="@drawable/bg_nexus_card"
        android:padding="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@id/operation_layout">

        <!-- Hidden tab layout anchor for compatibility -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/account_type_layout"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:visibility="gone"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="MissingConstraints">

            <com.angcyo.tablayout.DslTabLayout
                android:id="@+id/account_type_tab"
                android:layout_width="0dp"
                android:layout_height="0dp"
                tools:ignore="MissingConstraints" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Accounts RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/accounts_recycler"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:overScrollMode="never" />

        <!-- RICH EMPTY STATE CARD -->
        <LinearLayout
            android:id="@+id/empty_account_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_nexus_card"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingVertical="18dp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/bg_nexus_circle_btn"
                android:padding="12dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_nexus_user" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text="Belum Ada Akun Terdaftar"
                android:textColor="#FFFFFF"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:text="Tambahkan akun Microsoft atau buat akun Offline baru"
                android:textColor="#8E95A5"
                android:textSize="10.5sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <com.mattz.launcher.ui.view.AnimButton
                    android:id="@+id/empty_add_microsoft"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginEnd="8dp"
                    android:background="@drawable/bg_nexus_pill_glass"
                    android:paddingHorizontal="14dp"
                    android:text="@string/account_microsoft_account"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />

                <com.mattz.launcher.ui.view.AnimButton
                    android:id="@+id/empty_add_local"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_nexus_pill_white"
                    android:paddingHorizontal="14dp"
                    android:text="@string/account_local_account"
                    android:textAllCaps="false"
                    android:textColor="#050507"
                    android:textSize="10.5sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
