<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="36dp"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageButton
        android:id="@+id/refresh_button"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginEnd="6dp"
        android:background="@drawable/bg_nexus_circle_btn"
        android:contentDescription="@string/generic_refresh"
        android:padding="6dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_refresh" />

    <ImageButton
        android:id="@+id/search_button"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginEnd="6dp"
        android:background="@drawable/bg_nexus_circle_btn"
        android:contentDescription="@string/generic_search"
        android:padding="6dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_nexus_search" />

    <ImageButton
        android:id="@+id/paste_button"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginEnd="6dp"
        android:background="@drawable/bg_nexus_circle_btn"
        android:contentDescription="@string/generic_paste"
        android:padding="6dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_paste" />

    <ImageButton
        android:id="@+id/add_file_button"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginEnd="6dp"
        android:background="@drawable/bg_nexus_circle_btn"
        android:contentDescription="@string/file_add_file"
        android:padding="6dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_add_new" />

    <ImageButton
        android:id="@+id/create_folder_button"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginEnd="6dp"
        android:background="@drawable/bg_nexus_circle_btn"
        android:contentDescription="@string/file_create_folder"
        android:padding="6dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_nexus_plus" />

    <ImageButton
        android:id="@+id/return_button"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:background="@drawable/bg_nexus_circle_btn"
        android:contentDescription="@string/generic_return"
        android:padding="6dp"
        android:scaleType="centerInside"
        android:src="@drawable/ic_close" />

</LinearLayout>