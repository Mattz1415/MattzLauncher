<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    tools:ignore="ContentDescription,HardcodedText">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="16dp">

            <!-- Card 1: Overview & Links -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/constraintLayout3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_nexus_card"
                android:padding="12dp">

                <ImageView
                    android:id="@+id/title"
                    android:layout_width="160dp"
                    android:layout_height="28dp"
                    android:src="@drawable/app_name_title"
                    android:scaleType="centerInside"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/dec1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textColor="#FFFFFF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    app:layout_constraintTop_toBottomOf="@id/title" />

                <TextView
                    android:id="@+id/dec2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/nexus_text_muted"
                    android:textSize="10sp"
                    app:layout_constraintTop_toBottomOf="@id/dec1" />

                <TextView
                    android:id="@+id/dec3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textColor="@color/nexus_text_muted"
                    android:textSize="10sp"
                    app:layout_constraintTop_toBottomOf="@id/dec2" />

                <!-- Action Capsule Buttons Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:gravity="end|center_vertical"
                    android:orientation="horizontal"
                    app:layout_constraintTop_toBottomOf="@id/dec3">

                    <com.mattz.launcher.ui.view.AnimButton
                        android:id="@+id/discord_button"
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_nexus_pill_glass"
                        android:paddingHorizontal="12dp"
                        android:text="Discord"
                        android:textColor="#FFFFFF"
                        android:textSize="10sp" />

                    <com.mattz.launcher.ui.view.AnimButton
                        android:id="@+id/qq_group_button"
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_nexus_pill_glass"
                        android:paddingHorizontal="12dp"
                        android:text="QQ"
                        android:textColor="#FFFFFF"
                        android:textSize="10sp"
                        android:visibility="gone" />

                    <com.mattz.launcher.ui.view.AnimButton
                        android:id="@+id/github_button"
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_nexus_pill_glass"
                        android:paddingHorizontal="12dp"
                        android:text="GitHub"
                        android:textColor="#FFFFFF"
                        android:textSize="10sp" />

                    <com.mattz.launcher.ui.view.AnimButton
                        android:id="@+id/license_button"
                        android:layout_width="wrap_content"
                        android:layout_height="28dp"
                        android:background="@drawable/bg_nexus_pill_glass"
                        android:paddingHorizontal="12dp"
                        android:text="Lisensi"
                        android:textColor="#FFFFFF"
                        android:textSize="10sp" />

                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>

            <!-- Card 2: Contributors & Sponsors -->
            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/constraintLayout4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/bg_nexus_card"
                android:padding="12dp">

                <TextView
                    android:id="@+id/about_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/about_contributors"
                    android:textColor="#FFFFFF"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    app:layout_constraintTop_toTopOf="parent" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/about_recycler"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:paddingVertical="4dp"
                    app:layout_constraintTop_toBottomOf="@id/about_title" />

                <com.mattz.launcher.ui.view.AnimButton
                    android:id="@+id/sponsor"
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_nexus_pill_white"
                    android:text="@string/about_sponsors_list"
                    android:textColor="@color/nexus_pill_active_text"
                    android:textSize="10sp"
                    android:textStyle="bold"
                    app:layout_constraintTop_toBottomOf="@id/about_recycler" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>